# Conexão com o Postgres. No Railway, use a referência ${{Postgres.DATABASE_URL}}.
# Em desenvolvimento pode ficar sem definir: o servidor sobe um Postgres local em .pgdata/.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Segredo usado para assinar os tokens de sessão. Obrigatório em produção; gere um valor aleatório longo.
JWT_SECRET="troque-por-um-valor-aleatorio"
